.DS_Store
.idea/
__pycache__/
*.pyc

# Claude Code — ignore local state but keep shared project settings.
.claude/*
!.claude/settings.json

# Angular app (app/) build + tooling artifacts
node_modules/
app/dist/
app/.angular/
app/tmp/
app/out-tsc/

# Pipeline state — per-sweep rollback snapshots
*.bak

# Local design-review screenshots
.review-shots/
app/docs/screenshots/

# Keyword-sweep work artifacts — request and verdict files round-trip between
# the script and the judging agent. The script regenerates the request each run
# from discovered_keywords.json (the persistent state), and verdict files get
# archived after application. None of these are source of truth, so keep them
# out of git. (Now live under pipeline/state/.)
pipeline/state/keyword_judge_request.md
pipeline/state/keyword_judge_verdicts.json
pipeline/state/keyword_judge_verdicts.*.applied.json
pipeline/state/keyword_judge_verdicts.json.tmp*

# Pipeline scratch — collectors and sweep agents drop temporary workspaces and
# one-off scripts. Regenerated every run, never read by the app or any cadence
# consumer.
data/.tmp_*
data/.hnwork/
data/.sweep_apply.py
data/.sweep_state.json
.sweep_tmp/
pipeline/scripts/_scratch_*.py

# Claude Code local runtime state in the app workspace (scheduled-task locks etc).
app/.claude/

# Local-only caches and screenshots. The importance cache is regenerated every
# radar run; the screenshot cache holds preview captures from chrome-devtools.
.cache/
data/.cache/

# Local one-off scratch scripts that the vendor-sweep agent writes when
# debugging — short-lived and not source-of-truth.
pipeline/scripts/_vendor_sweep_run.py
