.DS_Store
.idea/
__pycache__/
*.pyc

# Claude Code — ignore local state but keep shared project settings.
.claude/*
!.claude/settings.json

# Angular app (app/) build + tooling artifacts
node_modules/
app/dist/
app/.angular/
app/tmp/
app/out-tsc/

# Pipeline state — per-sweep rollback snapshots
*.bak

# Local design-review screenshots
.review-shots/
app/docs/screenshots/

# Keyword-sweep work artifacts — request and verdict files round-trip between
# the script and the judging agent. The script regenerates the request each run
# from discovered_keywords.json (the persistent state), and verdict files get
# archived after application. None of these are source of truth, so keep them
# out of git. (Now live under pipeline/state/.)
pipeline/state/keyword_judge_request.md
pipeline/state/keyword_judge_verdicts.json
pipeline/state/keyword_judge_verdicts.*.applied.json
