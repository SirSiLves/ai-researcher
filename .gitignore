.DS_Store
.idea/
__pycache__/
*.pyc

# Claude Code — ignore local state but keep shared project settings.
.claude/*
!.claude/settings.json

# Angular app (app/) build + tooling artifacts
node_modules/
app/dist/
app/.angular/
app/tmp/
app/out-tsc/

# Pipeline state — per-sweep rollback snapshots
*.bak

# Local design-review screenshots
.review-shots/
app/docs/screenshots/

# Keyword-sweep work artifacts — request and verdict files round-trip between
# the script and the judging agent. The script regenerates the request each run
# from discovered_keywords.json (the persistent state), and verdict files get
# archived after application. None of these are source of truth, so keep them
# out of git. (Now live under pipeline/state/.)
pipeline/state/keyword_judge_request.md
pipeline/state/keyword_judge_verdicts.json
pipeline/state/keyword_judge_verdicts.*.applied.json
pipeline/state/keyword_judge_verdicts.json.tmp*

# Pipeline scratch — collectors and sweep agents drop temporary workspaces and
# one-off scripts. Regenerated every run, never read by the app or any cadence
# consumer.
data/.tmp_*
data/.hnwork/
data/.sweep_apply.py
data/.sweep_state.json
.sweep_tmp/
.sweeptmp/
pipeline/scripts/_scratch_*.py
pipeline/state/_tmp/
pipeline/state/_permtest*
pipeline/state/.write_test*
pipeline/state/.writetest*
pipeline/state/_writetest*
pipeline/state/.verdicts_overwrite_test.json
pipeline/state/err.txt

# Claude Code local runtime state in the app workspace (scheduled-task locks etc).
app/.claude/

# Local-only caches and screenshots. The importance cache is regenerated every
# radar run; the screenshot cache holds preview captures from chrome-devtools.
.cache/
data/.cache/

# Local one-off scratch scripts that the vendor-sweep agent writes when
# debugging — short-lived and not source-of-truth.
pipeline/scripts/_vendor_sweep_run.py
pipeline/scripts/_tmp_*
pipeline/scripts/gen_vendor_md.py

# GitHub-collector scratch workspaces (fetch/parse/update one-offs + raw
# fetch results). Regenerated every run.
data/.gh_*

# Permission-probe leftovers from sandboxed runs.
pipeline/state/.perm_probe
pipeline/state/_perm_test*
pipeline/state/_ovtest*
pipeline/state/.probe_vendor_test.txt
pipeline/state/_probe_test.txt
pipeline/state/.wtest*
pipeline/scripts/.wtest*
data/.wtest*
pipeline/state/keyword_judge_verdicts.json.wtest

# Collector scratch helpers. The sandboxed FS blocks unlink, so finished runs
# truncate these to a one-line tombstone instead of removing them.
data/.blogs_feeds*.py
data/.hn_scan_tmp.py
data/_gh_*.py
data/_sweep_apply.py
data/.briefing_lead_*.tmp
pipeline/scripts/_hn_*_tmp.py

# Keyword-judge one-off build/extract scripts, named per sweep date. The
# persistent state is discovered_keywords.json; these only reconstruct a single
# run's verdicts.
pipeline/state/_kwjudge_*

# Interrupted-write leftovers and dated state snapshots. github_stars.json and
# topic_keywords.json are the source of truth; these are partial or superseded.
pipeline/state/github_stars.json.new
pipeline/state/github_stars.json.tmp*
pipeline/state/topic_keywords.json.bak.*

# Pre-backfill state snapshots — tens of MB of local rollback copies.
pipeline/state_backups/
